SUPABASE_URL=https://fkkzedxbzbopspnuwtln.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Server-only. Never expose these with NEXT_PUBLIC_ prefixes.

# Gemini: set GEMINI_API_KEY (Google AI Studio) OR the two Vertex AI variables.
# Vertex uses Application Default Credentials (`gcloud auth application-default login`).
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Instagram scraping via Apify (recommended): https://console.apify.com/settings/integrations
# Runs apify/instagram-profile-scraper, billed per profile (~$0.0026 each on the free plan).
APIFY_TOKEN=
# APIFY_INSTAGRAM_ACTOR=apify~instagram-profile-scraper

# Fallback when APIFY_TOKEN is empty: Instagram's web endpoint, called from this server.
# Gets rate-limited per IP quickly. Optional `sessionid` cookie of a THROWAWAY account.
INSTAGRAM_SESSION_ID=

# Bearer token required by every mutating endpoint and by the cron jobs.
CRON_SECRET=replace-with-a-long-random-value
